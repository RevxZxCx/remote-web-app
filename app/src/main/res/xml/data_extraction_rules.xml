<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 的备份 / 设备迁移规则。

  本 App 本地只存一条设备凭证（等价于 FULL-CONTROL，见 D16），它**不应该**被备份或迁移到
  另一台设备：换设备必须重新配对。所以这里显式排除所有内容，而不是依赖默认值。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
